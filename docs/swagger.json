{
  "swagger": "2.0",
  "info": {
    "description": "CRUD API built with Go and Gin framework, connected to PostgreSQL.",
    "title": "Go Gin Example API",
    "termsOfService": "http://swagger.io/terms/",
    "contact": {
      "name": "API Support",
      "url": "http://www.example.com/support",
