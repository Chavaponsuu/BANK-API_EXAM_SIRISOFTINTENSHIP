    },
    "version": "1.0"
  },
  "host": "localhost:8080",
  "basePath": "",
  "paths": {
    "/api/v1/accounts": {
      "get": {
        "description": "Retrieve a paginated list of all accounts ordered by ID.",
        "produces": ["application/json"],
        "tags": ["accounts"],
        "summary": "List all accounts with pagination",
        "parameters": [
          {
            "type": "integer",
            "default": 1,
            "description": "Page number (default: 1, min: 1)",
            "name": "page",
            "in": "query"
          },
          {
            "type": "integer",
            "default": 10,
            "description": "Items per page (default: 10, max: 100)",
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of accounts with pagination metadata",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/dto.BaseResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/dto.AccountResponse"
                      }
                    },
                    "meta": {
                      "$ref": "#/definitions/dto.Meta"
                    }
                  }
                }
              ]
            }
          },
          "400": {
            "description": "Invalid page or limit parameters",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "500": {
            "description": "Failed to get account list",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          }
        }
      },
      "post": {
        "description": "Create a new bank account record. If initial_balance \u003e 0, creates a DEPOSIT transaction atomically.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["accounts"],
        "summary": "Create a new account",
        "parameters": [
          {
            "description": "Account payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/dto.CreateAccountRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Account created successfully",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/dto.BaseResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.AccountResponse"
                    }
                  }
                }
              ]
            }
          },
          "400": {
            "description": "Invalid input: citizen_id must be 13 digits, account_type must be SAVING or CURRENT, or balance cannot be negative",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "409": {
            "description": "Citizen ID already exists",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "500": {
            "description": "Failed to create account",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          }
        }
      }
    },
    "/api/v1/accounts/{account_number}": {
      "get": {
        "description": "Retrieve account details by 10-digit account number.",
        "produces": ["application/json"],
        "tags": ["accounts"],
        "summary": "Get account by account number",
        "parameters": [
          {
            "type": "string",
            "description": "Account Number (10 digits)",
            "name": "account_number",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Account found",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/dto.BaseResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.AccountResponse"
                    }
                  }
                }
              ]
            }
          },
          "400": {
            "description": "Invalid account_number format",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "404": {
            "description": "Account not found",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          }
        }
      }
    },
    "/api/v1/accounts/{account_number}/close": {
      "patch": {
        "description": "Change account status from ACTIVE to CLOSED. Closed accounts cannot perform transactions (deposit/withdraw).",
        "produces": ["application/json"],
        "tags": ["accounts"],
        "summary": "Close an account",
        "parameters": [
          {
            "type": "string",
            "description": "Account Number (10 digits)",
            "name": "account_number",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Account closed successfully",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/dto.BaseResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.CloseAccountResponse"
                    }
                  }
                }
              ]
            }
          },
          "400": {
            "description": "Invalid account number format",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "404": {
            "description": "Account not found",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "409": {
            "description": "Account is already closed",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "500": {
            "description": "Failed to close account",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          }
        }
      }
    },
    "/api/v1/accounts/{account_number}/deposit": {
      "post": {
        "description": "Deposit a specified amount into the account. Creates a DEPOSIT transaction and updates account balance atomically.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["transactions"],
        "summary": "Deposit money into an account",
        "parameters": [
          {
            "type": "string",
            "description": "Account Number (10 digits)",
            "name": "account_number",
            "in": "path",
            "required": true
          },
          {
            "description": "Deposit request payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/dto.TransactionRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deposit successful",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/dto.BaseResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.TransactionResponse"
                    }
                  }
                }
              ]
            }
          },
          "400": {
            "description": "Amount must be greater than 0",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "404": {
            "description": "Account not found",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "409": {
            "description": "Account is not active or already closed",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "500": {
            "description": "Failed to update account balance",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          }
        }
      }
    },
    "/api/v1/accounts/{account_number}/transactions": {
      "get": {
        "description": "Retrieve paginated transaction history for an account, ordered by newest first (created_at DESC).",
        "produces": ["application/json"],
        "tags": ["transactions"],
        "summary": "Get transaction history of an account",
        "parameters": [
          {
            "type": "string",
            "description": "Account Number (10 digits)",
            "name": "account_number",
            "in": "path",
            "required": true
          },
          {
            "type": "integer",
            "default": 1,
            "description": "Page number (default: 1, min: 1)",
            "name": "page",
            "in": "query"
          },
          {
            "type": "integer",
            "default": 10,
            "description": "Items per page (default: 10, max: 100)",
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction history with pagination",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/dto.BaseResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/dto.TransactionResponse"
                      }
                    },
                    "meta": {
                      "$ref": "#/definitions/dto.Meta"
                    }
                  }
                }
              ]
            }
          },
          "400": {
            "description": "Invalid account_number format or pagination parameters",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "404": {
            "description": "Account not found",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "500": {
            "description": "Failed to get transaction history",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          }
        }
      }
    },
    "/api/v1/accounts/{account_number}/withdraw": {
      "post": {
        "description": "Withdraw a specified amount from the account. Validates sufficient balance, creates a WITHDRAW transaction, and updates account balance atomically.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["transactions"],
        "summary": "Withdraw money from an account",
        "parameters": [
          {
            "type": "string",
            "description": "Account Number (10 digits)",
            "name": "account_number",
            "in": "path",
            "required": true
          },
          {
            "description": "Withdraw request payload",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/dto.TransactionRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Withdrawal successful",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/definitions/dto.BaseResponse"
                },
                {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/definitions/dto.TransactionResponse"
                    }
                  }
                }
              ]
            }
          },
          "400": {
            "description": "Insufficient balance or amount must be greater than 0",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "404": {
            "description": "Account not found",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "409": {
            "description": "Account is not active or already closed",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          },
          "500": {
            "description": "Failed to update account balance",
            "schema": {
              "$ref": "#/definitions/dto.BaseResponse"
            }
          }
        }
      }
    },
