  "definitions": {
    "dto.AccountResponse": {
      "type": "object",
      "properties": {
        "account_number": {
          "type": "string"
        },
        "account_type": {
          "type": "string",
          "example": "SAVING"
        },
        "balance": {
          "type": "number",
          "example": 1000
        },
        "owner_name": {
          "type": "string",
          "example": "John Doe"
        },
        "status": {
          "type": "string",
          "example": "ACTIVE"
        }
      }
    },
    "dto.BaseResponse": {
      "type": "object",
      "properties": {
        "data": {},
        "errors": {
          "type": "array",
          "items": {}
        },
        "message": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/definitions/dto.Meta"
        },
        "success": {
          "type": "boolean"
        }
      }
    },
    "dto.CloseAccountResponse": {
      "type": "object",
      "properties": {
        "account_number": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "dto.CreateAccountRequest": {
      "type": "object",
      "required": ["account_type", "citizen_id", "owner_name", "phone_number"],
      "properties": {
        "account_type": {
          "type": "string",
          "enum": ["SAVING", "CURRENT"],
          "example": "SAVING"
        },
        "citizen_id": {
          "type": "string",
          "example": "1234567890123"
        },
        "initial_balance": {
          "type": "number",
          "minimum": 0,
          "example": 1000
        },
        "owner_name": {
          "type": "string",
          "example": "John Doe"
        },
        "phone_number": {
          "type": "string",
          "example": "0812345678"
        }
      }
    },
    "dto.CreateExampleRequest": {
      "type": "object",
      "required": ["email", "name"],
      "properties": {
        "email": {
          "type": "string",
          "example": "john@example.com"
        },
        "name": {
          "type": "string",
          "example": "John Doe"
        }
      }
    },
    "dto.ExampleDeleteResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        }
      }
    },
    "dto.ExampleResponse": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "example": "2024-01-01T00:00:00Z"
        },
        "email": {
          "type": "string",
          "example": "john@example.com"
        },
        "id": {
          "type": "integer",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "updated_at": {
